// ==========================================
// SAUDAÇÃO AUTOMÁTICA
// ==========================================

function saudacao() {

    var agora = new Date();
    var hora = agora.getHours();

    var diasDaSemana = [
        "domingo",
        "segunda-feira",
        "terça-feira",
        "quarta-feira",
        "quinta-feira",
        "sexta-feira",
        "sábado"
    ];

    var dia = diasDaSemana[agora.getDay()];

    var mensagem;

    if (hora >= 5 && hora < 12) {

        mensagem = "Bom Dia!";

    } else if (hora >= 12 && hora < 18) {

        mensagem = "Boa Tarde!";

    } else {

        mensagem = "Boa Noite!";

    }

    alert(
        "Nome: " + nome + "\n" +
        "Cidade: " + cidade + "\n" +
        "Curso: " + curso + "\n" +
        "Universidade: " + universidade + "\n" +
        mensagem + "\n" +
        "Hoje é " + dia
    );
}

// ==========================================
// MENU DE INFORMAÇÕES
// ==========================================

function togglePontinhos() {

    const menu = document.getElementById('dropdown-info');

    menu.classList.toggle('mostrar');

}

// Fecha o menu ao clicar fora dele

window.onclick = function(event) {

    if (!event.target.closest('.menu-container')) {

        const menu = document.getElementById('dropdown-info');

        if (menu && menu.classList.contains('mostrar')) {

            menu.classList.remove('mostrar');

        }

    }

};

