/* --- ESTILO GERAL --- */
* {
    box-sizing: border-box;
}

body {
    background-color: #000000;
    color: #333333;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    margin: 0;
    padding: 0;
}

/* --- CABEÇALHO E NAVEGAÇÃO --- */
.top-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 40px;
    background: #5a2685;
    border-bottom: 1px solid #e5e5e5;
}

.logo {
    font-weight: 700;
    font-size: 35px;
    color: #000000;
}

.nav-links a {
    margin: 0 15px;
    text-decoration: none;
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
}

.nav-links a:hover {
    color: #286cff;
}

/* Menu de três pontinhos */
.menu-container {
    position: relative;
}

.botao-pontinhos {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    padding: 0;
}

.botao-pontinhos span {
    display: block;
    width: 100%;
    height: 3px;
    background-color: #222222;
    border-radius: 2px;
}

.dropdown-menu {
    display: none;
    position: absolute;
    right: 0;
    top: 30px;
    background-color: #1e1e1e;
    min-width: 180px;
    border-radius: 8px;
    box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.3);
    z-index: 1000;
    overflow: hidden;
}

.dropdown-menu.ativo {
    display: block;
}

.menu-links {
    display: flex;
    flex-direction: column;
}

.menu-links a {
    color: #ffffff;
    padding: 12px 16px;
    text-decoration: none;
    font-size: 14px;
}

.menu-links a:hover {
    background-color: #333333;
}

/* --- HERO BANNER --- */
.hero-banner {
    display: grid;
    grid-template-columns: 1.5fr 2fr 1fr;
    align-items: center;
    background: #8d8d8d;
    padding: 40px;
    margin: 20px 40px;
    border-radius: 16px;
}

.sub-title {
    font-size: 12px;
    color: #fffdfd;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.hero-text h1 {
    font-size: 40px;
    line-height: 1.1;
    margin: 10px 0;
    color: #111111;
}

.hero-text h1 span {
    color: #ffffff;
}

.btn-shop {
    background: #e63946;
    color: #ffffff;
    padding: 10px 22px;
    border-radius: 20px;
    text-decoration: none;
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
}

.hero-image img {
    width: 100%;
    max-height: 250px;
    object-fit: contain;
}

.hero-description {
    font-size: 12px;
    color: #ffffff;
}

/* --- GRELHA DE CATEGORIAS --- */
.categories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 0 40px;
    margin-bottom: 30px;
}

.cat-card {
    padding: 25px;
    border-radius: 14px;
    color: #000000;
    min-height: 160px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.cat-card p {
     color: #ffffff;
    margin: 0;
    font-size: 12px;
    opacity: 0.85;
}
.cat-card img {
    max-width: 100%;
    height: 120px;
    object-fit: contain;
    /* Faz o fundo branco da imagem mesclar e desaparecer */
    mix-blend-mode: multiply;
}

.cat-card h3 {
    margin: 5px 0 0 0;
    font-size: 22px;
}

.btn-browse {
    background: rgba(0, 0, 0, 0.25);
     background: rgb(0, 0, 0); color: #fffcfc; 
    padding: 6px 16px;
    border-radius: 15px;
    text-decoration: none;
    width: fit-content;
    font-size: 11px;
    font-weight: 600;
}

/* Cores das Categorias */
.cat-card.dark { background: #919191; }
.cat-card.red { background: linear-gradient(135deg, #919191, #919191); }
.cat-card.yellow { background: #919191; color: #000000; }
.cat-card.yellow .btn-browse { background: rgb(0, 0, 0); color: #fdfbfb; }
.cat-card.blue { background: #919191; }
.cat-card.green { background: #919191; }
.cat-card.pink { background: #919191; }

/* --- BARRA DE VANTAGENS --- */
.features-bar {
    display: flex;
    justify-content: space-around;
    background: #ffffff;
    padding: 20px;
    margin: 20px 40px;
    border-radius: 12px;
    font-size: 13px;
    border: 1px solid #e5e5e5;
}

/* --- PROMO BANNERS (XBOX) --- */
.promo-banner {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1.2fr;
    align-items: center;
    background: #471e68;
    color: #ffffff;
    padding: 40px;
    margin: 20px 40px;
    border-radius: 16px;
}

.badge {
    background: #00b894;
    padding: 4px 8px;
    font-size: 11px;
    border-radius: 4px;
    font-weight: 600;
}

.promo-left h2 {
    font-size: 30px;
    line-height: 1;
    margin: 10px 0;
}

.promo-center img {
    width: 90%;
    max-height: 205px;
    object-fit: contain;
}

.promo-right .btn-shop {
    background: #000000;
    color: #ffffff;
}

/* --- RODAPÉ --- */
footer {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    background-color: #5a2685;
    color: #ffffff;
    padding: 20px;
    margin-top: 40px;
    gap: 12px;
    text-align: center;
}

footer p {
    margin: 0;
    font-size: 14px;
}
